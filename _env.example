# ============================================================
# GLOBAL CONFIGURATION — shared by NexaFlow backend + Document Parser
# ============================================================
# This ONE file is the single source of truth for every product.
# Copy this file to `.env` in the same folder, fill in real values,
# and keep `.env` out of source control (it's already in .gitignore).
# Both `nexaflow-backend` and `DP-backend` walk up their own directory
# tree at startup (via python-dotenv) and will find and load `.env`
# automatically.

# ------------------------------------------------------------
# DATABASE (MS SQL Server) — one server, one login, many databases
# ------------------------------------------------------------
DB_SERVER=192.168.0.10
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_USE_WINDOWS_AUTH=false
DB_USER=sa
DB_PASSWORD=Admin@123
DB_TIMEOUT=10
# Each product keeps its own database on the same SQL Server instance.
NEXAFLOW_DB_NAME=OneNextGenDB
PRODUCT_DB_NAME=onenextgenproductDB
BUSINESSMAP_DB_NAME=onenextgenBusinessMapDB

# ------------------------------------------------------------
# SECURITY — shared JWT signing key
# ------------------------------------------------------------
# NexaFlow issues the token at login. Document Parser (and any other
# product added later) verifies the SAME token using this SAME secret
# instead of trusting requests blindly. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=nexaflow-super-secret-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ------------------------------------------------------------
# CORS — comma separated list of frontend origins allowed to call
# EITHER backend. Add your real deployed frontend URL(s) here.
# ------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------------------------
# SERVICE PORTS (used by run.py for each backend)
# ------------------------------------------------------------
NEXAFLOW_BACKEND_PORT=8001
DOCPARSER_BACKEND_PORT=8000

# Business Map orchestrator + its two model services (native run via
# Business-Map-Backend/run_backend.py). Reassigned to the 802x range so
# they don't collide with the other backends (8000/8001).
BUSINESSMAP_ORCHESTRATOR_PORT=8020
BUSINESSMAP_AUDIO_PORT=8021
BUSINESSMAP_VIDEO_PORT=8022

# ------------------------------------------------------------
# FRONTEND — API base URLs the NexaFlow React app calls.
# Two DIFFERENT variable names on purpose: Vite only lets you set one
# value per name, so if both backends read the same name, setting it
# for production silently breaks whichever service you didn't mean.
# ------------------------------------------------------------
VITE_MAIN_API_BASE_URL=http://127.0.0.1:8001
VITE_DOCUMENT_PARSER_API_BASE_URL=http://127.0.0.1:8000
VITE_BUSINESS_MAP_API_BASE_URL=http://127.0.0.1:8020

# ------------------------------------------------------------
# DOCUMENT PARSER — uploads & generated output
# ------------------------------------------------------------
# UPLOAD_DIR and OUTPUT_ROOT are intentionally NOT set here. When unset,
# DP-backend/app/core/config.py defaults them to "uploads/" and
# "Output/" directly under the Document Parser backend folder itself.
# Only set these if you need to point them somewhere else entirely
# (e.g. a separate disk/mount in production).
MAX_UPLOAD_SIZE_MB=50

# ------------------------------------------------------------
# SMTP / EMAIL (NexaFlow backend only — password resets, contact
# forms, demo requests)
# ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ramyarpasde2026@gmail.com
SMTP_PASS=ahtx kdyk zgpn dtno
MAIL_FROM_NAME=OneNextGen Automation
MAIL_FROM_EMAIL=ramyarpasde2026@gmail.com
