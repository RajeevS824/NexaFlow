# Bind-mounted output/logs/tmp created by docker-compose.yml — keep the
# folders themselves (via .gitkeep) but not their runtime contents.
/Business-Map-Backend/AudioVideoPipeline/Orchestrator/output/*
!/Business-Map-Backend/AudioVideoPipeline/Orchestrator/output/.gitkeep
/Business-Map-Backend/AudioVideoPipeline/Orchestrator/logs/*
!/Business-Map-Backend/AudioVideoPipeline/Orchestrator/logs/.gitkeep
/Business-Map-Backend/AudioVideoPipeline/Orchestrator/tmp/*
!/Business-Map-Backend/AudioVideoPipeline/Orchestrator/tmp/.gitkeep
/Business-Map-Backend/AudioVideoPipeline/audio_service/output/*
!/Business-Map-Backend/AudioVideoPipeline/audio_service/output/.gitkeep
/Business-Map-Backend/AudioVideoPipeline/audio_service/logs/*
!/Business-Map-Backend/AudioVideoPipeline/audio_service/logs/.gitkeep
/Business-Map-Backend/AudioVideoPipeline/audio_service/tmp/*
!/Business-Map-Backend/AudioVideoPipeline/audio_service/tmp/.gitkeep
/Business-Map-Backend/AudioVideoPipeline/video_service/logs/*
!/Business-Map-Backend/AudioVideoPipeline/video_service/logs/.gitkeep
/Business-Map-Backend/AudioVideoPipeline/video_service/tmp/*
!/Business-Map-Backend/AudioVideoPipeline/video_service/tmp/.gitkeep
