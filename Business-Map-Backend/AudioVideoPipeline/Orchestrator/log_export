"""
log_exporter.py
================
Reads the shared orchestrator.log file, extracts only the high-level
events for a specific job_id, and writes a clean, properly-escaped CSV
to the user's configured log folder (from UserLogSettings in the DB,
or the default folder if the DB is not enabled).

The exported CSV is an *execution summary* — one meaningful event per
row — NOT a full debug dump. Verbose lines (per-frame analysis, poll
retries, intermediate ffprobe/ffmpeg output, raw LLM tokens, etc.) are
intentionally excluded. The goal is a file a non-engineer can open in
Excel and immediately understand: what happened, in what order, and
whether it succeeded.

CSV columns:
  Timestamp | Level | Module | Event | Status | Message
"""

import csv
import logging
import os
import re
from datetime import datetime
from pathlib import Path
from typing import Optional

logger = logging.getLogger("LogExporter")

# ------------------------------------------------------------------ #
#  1.  LOG LINE PARSER                                                 #
# ------------------------------------------------------------------ #
# Main log format (set in integrated_pipeline.py basicConfig):
#   2026-07-30 10:27:23,781 | OrchestratorPipeline | INFO | [UDQK2746] Received: video1sec.mp4 ...
_LOG_RE = re.compile(
    r"^(?P<ts>\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2},\d+)"
    r"\s*\|\s*(?P<name>[^|]+?)"
    r"\s*\|\s*(?P<level>[A-Z]+)"
    r"\s*\|\s*(?P<msg>.+)$"
)


def _parse_line(line: str) -> Optional[dict]:
    m = _LOG_RE.match(line.rstrip())
    if not m:
        return None
    return {
        "ts":    m.group("ts"),
        "name":  m.group("name").strip(),
        "level": m.group("level").strip(),
        "msg":   m.group("msg").strip(),
    }


# ------------------------------------------------------------------ #
#  2.  EVENT CLASSIFIER                                                #
# ------------------------------------------------------------------ #
# Each entry: (regex_pattern, event_label, module, status)
# Lines are tested in order — first match wins, so more-specific
# patterns must come before more-general ones.
# Lines that match NO pattern are skipped entirely (excluded from CSV).
_EVENT_RULES = [
    # ── Pipeline lifecycle ──────────────────────────────────────────
    (r"Pipeline started",               "Pipeline Started",         "OrchestratorPipeline", "INFO"),
