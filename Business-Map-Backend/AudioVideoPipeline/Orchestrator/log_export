# Pre-compile for speed
_COMPILED_RULES = [
    (re.compile(pat, re.IGNORECASE), event, module, status)
    for pat, event, module, status in _EVENT_RULES
]


def _classify(msg: str, level: str) -> Optional[tuple]:
    """
    Returns (event, module, status, clean_message) or None if this line
    should be excluded from the CSV (verbose/debug/retry/internal detail).
    """
    for pattern, event, module, status in _COMPILED_RULES:
        if pattern.search(msg):
            # Use the classifier's status, but escalate to ERROR if the
            # raw log line is actually an error regardless of rule default.
            effective_status = status if status in ("SUCCESS", "PARTIAL", "CANCELLED", "WARNING") \
                else ("ERROR" if level == "ERROR" else status)
            return event, module, effective_status, msg
    return None


# ------------------------------------------------------------------ #
#  3.  LOG FILE READER — filter to one job                            #
# ------------------------------------------------------------------ #

def _read_job_events(log_file: Path, job_id: str) -> list[dict]:
    """
    Reads `log_file` line by line, returns only parsed + classified
    events that belong to `job_id` (matched by `[job_id]` anywhere in
    the message), in file order (chronological).
    """
    events = []
    if not log_file.exists():
        logger.warning(f"Log file not found: {log_file}")
        return events

    try:
        with open(log_file, "r", encoding="utf-8", errors="replace") as f:
            for line in f:
                parsed = _parse_line(line)
                if parsed is None:
                    continue
                # Only include lines that mention this specific job_id
                if job_id not in parsed["msg"]:
                    continue
                classified = _classify(parsed["msg"], parsed["level"])
                if classified is None:
                    continue
                event, module, status, message = classified
                events.append({
                    "Timestamp": parsed["ts"].replace(",", "."),
                    "Level":     parsed["level"],
                    "Module":    module,
                    "Event":     event,
                    "Status":    status,
                    "Message":   message,
                })
    except OSError as e:
        logger.error(f"Could not read log file {log_file}: {e}")

    return events


# ------------------------------------------------------------------ #
#  4.  CSV WRITER                                                      #
# ------------------------------------------------------------------ #
COLUMNS = ["Timestamp", "Level", "Module", "Event", "Status", "Message"]


def export_job_csv(
    job_id: str,
    job_name: str,
    log_file: Path,
    output_folder: str,
    final_status: str = "",
) -> Optional[Path]:
    """
    Public entry point. Reads `log_file`, extracts events for `job_id`,
    and writes a CSV to `output_folder`. Returns the Path of the written
    file, or None if no events were found or writing failed.

    Called from integrated_pipeline.py's `finally` block in
    run_full_pipeline_bg, so it runs on every job completion regardless
    of whether the job succeeded, failed, or was cancelled.

    Parameters
    ----------
    job_id        : the short ID, e.g. "UDQK2746"
    job_name      : human label, used in the output filename
    log_file      : absolute Path to the orchestrator.log file
    output_folder : where to write the CSV (from UserLogSettings)
    final_status  : "SUCCESS" / "FAILED" / "CANCELLED" / "" — appended
                    as a trailing summary row if provided
    """
    events = _read_job_events(log_file, job_id)

    if not events:
        logger.warning(f"[{job_id}] No classified log events found — CSV not written.")
        return None

    # Append a summary row at the end so the final status is visible at
    # a glance without having to scroll to the last "meaningful" row.
    if final_status:
        events.append({
            "Timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S.000"),
            "Level":     final_status if final_status in ("ERROR", "WARNING") else "INFO",
            "Module":    "LogExporter",
            "Event":     "Export Summary",
            "Status":    final_status,
            "Message":   f"Job {job_id} ({job_name}) finished with status: {final_status}",
        })

    try:
        folder = Path(output_folder)
        folder.mkdir(parents=True, exist_ok=True)

        # Filename: <job_name>_<job_id>_<date>.csv — human-readable but
        # unique across re-runs of the same job name on the same day.
        date_str  = datetime.now().strftime("%Y%m%d_%H%M%S")
        safe_name = re.sub(r"[^\w\-]", "_", job_name)
        csv_path  = folder / f"{safe_name}_{job_id}_{date_str}.csv"

        with open(csv_path, "w", newline="", encoding="utf-8-sig") as f:
            # utf-8-sig writes the BOM (byte order mark) that Excel on
            # Windows requires to auto-detect UTF-8 and render correctly
            # without the user having to choose an encoding manually.
            writer = csv.DictWriter(
                f,
                fieldnames=COLUMNS,
                extrasaction="ignore",
                quoting=csv.QUOTE_ALL,   # quote every field — avoids
                                          # any ambiguity in Excel with
                                          # commas/newlines in messages
            )
            writer.writeheader()
            writer.writerows(events)

        logger.info(f"[{job_id}] Log CSV exported: {csv_path} ({len(events)} rows)")
        return csv_path

    except OSError as e:
        logger.error(f"[{job_id}] Failed to write CSV to {output_folder}: {e}")
        return None